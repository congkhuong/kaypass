{
  "manifest_version": 3,
  "name": "KayPass - Secure Password Manager",
  "version": "1.2.0",
  "description": "Lưu trữ mật khẩu an toàn mã hóa AES-256, tự động đăng nhập và sao lưu mã hóa trên Google Drive.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "identity"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
